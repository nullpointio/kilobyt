<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kilobyt.Core: cross-platform, dependency-free, fully unit-testable on Linux.
       DO NOT add any PackageReference, System.Drawing, Windows API, or network code here.
       See docs/prd.md §5.8 and risk R1. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Kilobyt.Core</RootNamespace>
    <AssemblyName>Kilobyt.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
