// Win32 resources for Kilobyt.exe, compiled by build.rs with windres
// (*-windows-gnu) or rc.exe (*-msvc). Both read this file from assets/ via -I.
//
// code_page(65001) is what lets rc.exe read this file as UTF-8; windres does so
// by default. Keep the file UTF-8 without a BOM.
#pragma code_page(65001)

// RT_MANIFEST (24) with CREATEPROCESS_MANIFEST_RESOURCE_ID (1). The numeric
// forms avoid needing a resource compiler that can preprocess <windows.h>.
1 24 "kilobyt.manifest"

// The app icon. The `ICON` keyword (rather than a numeric RT_GROUP_ICON id) is
// what makes the resource compiler unpack the .ico into one RT_ICON per frame
// plus the RT_GROUP_ICON directory that Explorer reads. Id 1 is also what the
// Win32 code loads at runtime (see `app_icon` in src/ui_windows.rs).
1 ICON "icon.ico"

// Version stamp read by Task Manager's Description column, Explorer's Details
// tab and `(Get-Item .\Kilobyt.exe).VersionInfo`. Keep every version field in
// sync with [package] version in Cargo.toml.
1 VERSIONINFO
FILEVERSION 1,1,4,0
PRODUCTVERSION 1,1,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "nullpointio"
            VALUE "FileDescription", "Compress a photo to fit a hard upload limit, offline"
            VALUE "FileVersion", "1.1.4.0"
            VALUE "InternalName", "kilobyt"
            VALUE "LegalCopyright", "MIT License — nullpointio"
            VALUE "OriginalFilename", "Kilobyt.exe"
            VALUE "ProductName", "Kilobyt"
            VALUE "ProductVersion", "1.1.4.0"
            VALUE "Comments", "Exact byte-target JPEG compression. Nothing is uploaded."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
